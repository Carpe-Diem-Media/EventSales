PER_COMMAND_SECONDS = 3
WORK_SECONDS = 35
TOTAL_SECONDS = 40
TERM_SECONDS = 1
REAP_SECONDS = 1
MAX_STDOUT = 4096
MAX_STDERR = 1024
MAX_RECORDS = 12
MAX_RECORD_BYTES = 512
MAX_COMMANDS = 10
REPORT_MAX = 16 * 1024
REPORT_END = 'REPORT_END=YES'
