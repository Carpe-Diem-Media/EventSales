#!/bin/bash -p
set -euo pipefail
set +x
umask 077

if (($# != 0)); then
  exit 64 # Caller arguments forbidden; do not block on an unread diagnostic pipe.
fi
if ((EUID != 0)); then
  exit 77 # Root required.
fi
cd / 2>/dev/null || exit 78

exec /usr/bin/env -i PATH=/usr/sbin:/usr/bin:/sbin:/bin LC_ALL=C HOME=/nonexistent DOCKER_CONFIG=/nonexistent/eventsales-audit-config DOCKER_HOST=unix:///var/run/docker.sock /usr/bin/python3 -I -S -B - <<'PY'
